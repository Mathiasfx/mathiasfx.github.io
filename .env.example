# Firebase Admin credentials (used during build / server)
# Copy values from your Firebase Service Account or CI secrets
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Nombre exacto de la colección en Firestore (ej. "post" o "posts")
FIREBASE_POSTS_COLLECTION=post

